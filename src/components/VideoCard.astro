---
import { getImage } from 'astro:assets';
import { useTranslations, type Lang } from '../lib/i18n';

interface Props {
  id: string;
  title: string;
  role?: string;
  year?: number;
  featured?: boolean;
  thumbnail?: ImageMetadata;
  thumbnailPosition?: string;
  index?: number;
  lang: Lang;
}

const { id, title, role, year, featured = false, thumbnail, thumbnailPosition, index = 0, lang } = Astro.props;
const t = useTranslations(lang);

const posterStyle = thumbnail
  ? `background-image:url(${(await getImage({ src: thumbnail, width: 800 })).src})${thumbnailPosition ? `;background-position:${thumbnailPosition}` : ''}`
  : undefined;
---

<article
  class:list={['reveal', 'video-card', featured && 'video-card--featured']}
  style={`--reveal-i: ${index}`}
  data-reveal
  data-cursor="play"
>
  <div class="video-card__frame">
    <lite-youtube
      videoid={id}
      params="rel=0&modestbranding=1&color=white&iv_load_policy=3&cc_load_policy=0"
      style={posterStyle}
    >
      <span class="visually-hidden">{t.videoPlayLabel(title)}</span>
    </lite-youtube>
  </div>
  <div class="video-card__meta">
    <h3 class="video-card__title">{title}</h3>
    {(role || year) && (
      <p class="video-card__role">
        {role}
        {role && year ? ' — ' : ''}
        {year}
      </p>
    )}
  </div>
</article>

<style>
  .video-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .video-card--featured {
    grid-column: 1 / -1;
  }

  .video-card__frame {
    position: relative;
    overflow: hidden;
    background: var(--surface);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .video-card:hover .video-card__frame {
    transform: scale(1.015);
  }

  lite-youtube {
    background-color: var(--surface);
    width: 100%;
    max-width: none; /* the library's own default caps this at 720px */
    aspect-ratio: 16 / 9;
  }

  /* Once a video is playing, its own YouTube controls take over — stop
     floating our custom "Play" cursor on top of them. */
  .video-card:has(lite-youtube.lyt-activated) {
    cursor: auto;
  }

  .video-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .video-card__role {
    margin-top: 0.35em;
    font-size: var(--fs-small);
    letter-spacing: 0.04em;
    color: var(--muted);
  }
</style>
