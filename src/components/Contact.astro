---
interface Social {
  label: string;
  url: string;
}

interface Props {
  email: string;
  location?: string;
  social: Social[];
}

const { email, location, social } = Astro.props;
const year = new Date().getFullYear();
---

<section id="contact" class="contact">
  <div class="container">
    <p class="reveal eyebrow" data-reveal>04 — Contact</p>
    <a href={`mailto:${email}`} class="reveal display contact__email" data-reveal style="--reveal-i: 1">
      {email}
    </a>

    <div class="contact__row">
      <ul class="reveal contact__social" data-reveal style="--reveal-i: 2">
        {
          social.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`${s.label} (opens in a new tab)`}>
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>

      {location && (
        <p class="reveal contact__location eyebrow" data-reveal style="--reveal-i: 3">
          {location}
        </p>
      )}
    </div>
  </div>

  <footer class="contact__footer">
    <p>&copy; {year} — All rights reserved.</p>
  </footer>
</section>

<style>
  .contact {
    padding-bottom: var(--space-md);
  }

  .contact__email {
    display: inline-block;
    margin-top: var(--space-sm);
    font-size: clamp(1.75rem, 5vw, 4.5rem);
    text-decoration: none;
    color: var(--fg);
    border-bottom: 1px solid var(--line);
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }

  .contact__email:hover,
  .contact__email:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }

  .contact__row {
    margin-top: var(--space-lg);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-md);
  }

  .contact__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contact__social a {
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .contact__social a:hover,
  .contact__social a:focus-visible {
    color: var(--fg);
  }

  .contact__location {
    color: var(--muted);
  }

  .contact__footer {
    margin-top: var(--space-section);
    padding-block: var(--space-md);
    border-top: 1px solid var(--line);
  }

  .contact__footer p {
    max-width: var(--container);
    margin-inline: auto;
    font-size: var(--fs-small);
    color: var(--muted);
  }
</style>
