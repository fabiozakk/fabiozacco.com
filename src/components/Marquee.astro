---
// Horizontal credits ticker. Pure CSS keyframe by default (also the
// reduced-motion / no-JS fallback); src/scripts/motion.ts progressively
// enhances it with scroll-linked speed when motion is enabled.
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track" data-marquee-track>
    {
      [...items, ...items].map((item) => (
        <span class="marquee__item">
          {item}
          <span class="marquee__dot">●</span>
        </span>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: var(--space-md);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 22s linear infinite;
  }

  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-lg);
    padding-inline-end: var(--space-lg);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 3rem);
    color: var(--muted);
    white-space: nowrap;
  }

  .marquee__dot {
    color: var(--accent);
    font-size: 0.5em;
  }

  @keyframes marquee {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation-play-state: paused;
    }
  }
</style>
