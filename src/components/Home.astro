---
import { render } from 'astro:content';
import 'lite-youtube-embed/src/lite-yt-embed.css';

import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Bio from './Bio.astro';
import VideoSection from './VideoSection.astro';
import Marquee from './Marquee.astro';
import Contact from './Contact.astro';
import Grain from './Grain.astro';
import { extractYouTubeId } from '../lib/youtube';
import { getLocalizedEntry, getLocalizedCollection, useTranslations, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const siteEntry = await getLocalizedEntry('site', lang);
const heroEntry = await getLocalizedEntry('hero', lang);
const bioEntry = await getLocalizedEntry('bio', lang);

const site = siteEntry.data;
const hero = heroEntry.data;
const { Content: BioContent } = await render(bioEntry);

async function loadVideos(collection: 'playing' | 'scoring') {
  const entries = await getLocalizedCollection(collection, lang);
  return entries
    .sort((a, b) => a.data.order - b.data.order)
    .map((entry) => {
      const id = extractYouTubeId(entry.data.youtube);
      if (!id) {
        console.warn(
          `[${collection}] "${entry.data.title}" (${entry.id}) has an invalid youtube value: "${entry.data.youtube}" — skipped.`,
        );
        return null;
      }
      return {
        id,
        title: entry.data.title,
        role: entry.data.role,
        year: entry.data.year,
        featured: entry.data.featured,
        thumbnail: entry.data.thumbnail,
        thumbnailPosition: entry.data.thumbnailPosition,
      };
    })
    .filter((v): v is NonNullable<typeof v> => v !== null);
}

const playing = await loadVideos('playing');
const scoring = await loadVideos('scoring');
---

<Base lang={lang}>
  <Grain />
  <div class="play-cursor" data-play-cursor aria-hidden="true">
    <span>Play</span>
  </div>

  <Nav name={site.name} lang={lang} />

  <main id="main">
    <Hero
      headline={hero.headline}
      subhead={hero.subhead}
      video={hero.video}
      poster={hero.poster}
      posterPosition={hero.posterPosition}
      images={hero.images}
      interval={hero.interval}
      lang={lang}
    />

    <Bio
      portrait={bioEntry.data.portrait}
      portraitPosition={bioEntry.data.portraitPosition}
      name={site.name}
      lang={lang}
    >
      <BioContent />
    </Bio>

    <Marquee items={t.marquee} />

    <VideoSection id="playing" section="playing" lang={lang} entries={playing} />

    <VideoSection id="scoring" section="scoring" lang={lang} entries={scoring} />

    <Marquee items={t.marquee} />

    <Contact email={site.email} location={site.location} social={site.social} lang={lang} />
  </main>

  <script>
    import 'lite-youtube-embed';
  </script>
  <script src="../scripts/motion.ts"></script>
</Base>
