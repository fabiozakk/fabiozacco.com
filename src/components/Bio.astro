---
import { Image } from 'astro:assets';
import { useTranslations, type Lang } from '../lib/i18n';

interface Props {
  portrait: ImageMetadata;
  portraitPosition?: string;
  name: string;
  lang: Lang;
}

const { portrait, portraitPosition, name, lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="bio" class="bio">
  <div class="container bio__grid">
    <div class="reveal bio__portrait-wrap" data-reveal>
      <Image
        src={portrait}
        alt={`Portrait of ${name}`}
        class="bio__portrait"
        widths={[400, 700, 1000, 1400]}
        sizes="(max-width: 56em) 80vw, 32vw"
        style={portraitPosition ? `--pos: ${portraitPosition}` : undefined}
      />
    </div>

    <div class="bio__copy">
      <p class="reveal eyebrow bio__label" data-reveal>{t.sections.bio.eyebrow}</p>
      <div class="reveal bio__text" data-reveal style="--reveal-i: 1">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .bio__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .bio__portrait-wrap {
    position: sticky;
    top: 6rem;
  }

  .bio__portrait {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: var(--pos, center);
    filter: grayscale(0.35) contrast(1.05);
  }

  .bio__label {
    margin-bottom: var(--space-md);
  }

  .bio__text {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--fg);
    max-width: 26ch;
  }

  .bio__text :global(p + p) {
    margin-top: 1em;
  }

  @media (max-width: 56em) {
    .bio__grid {
      grid-template-columns: 1fr;
    }

    .bio__portrait-wrap {
      position: static;
      max-width: 22rem;
    }

    .bio__text {
      max-width: none;
      font-size: var(--fs-h3);
    }
  }
</style>
