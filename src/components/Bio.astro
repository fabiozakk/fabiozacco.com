---
import { Image } from 'astro:assets';
import { useTranslations, type Lang } from '../lib/i18n';

interface Props {
  portrait: ImageMetadata;
  portraitPosition?: string;
  name: string;
  lang: Lang;
}

const { portrait, portraitPosition, name, lang } = Astro.props;
const t = useTranslations(lang);

// The frame is a 4/5 portrait. `object-fit: cover` on a source that's wider
// than that scales it up until its *height* fills the frame, so the image is
// actually painted wider than the frame and the sides are cropped — a
// landscape photo ends up rendered ~1.9x the frame's width. `sizes` has to
// describe that painted width, not the frame, or the browser picks a
// candidate meant for the frame and the result looks soft on retina.
const FRAME_RATIO = 4 / 5;
const COLUMN_VW = { mobile: 80, desktop: 37 };
// The container stops growing at 1440px, so past that the painted width is
// fixed and a plain vw would keep asking for ever-larger files.
const COLUMN_MAX_PX = 1440 * 0.425;
const coverScale = Math.max(1, portrait.width / portrait.height / FRAME_RATIO);
const sizes = [
  `(max-width: 56em) ${Math.round(COLUMN_VW.mobile * coverScale)}vw`,
  `min(${Math.round(COLUMN_VW.desktop * coverScale)}vw, ${Math.round(COLUMN_MAX_PX * coverScale)}px)`,
].join(', ');

// Reaches far enough for 2-3x displays; capped so Astro never upscales.
const widths = [600, 900, 1200, 1600, 2000, 2600, 3200].filter((w) => w <= portrait.width);
---

<section id="bio" class="bio">
  <div class="container bio__grid">
    <div class="reveal bio__portrait-wrap" data-reveal>
      <Image
        src={portrait}
        alt={`Portrait of ${name}`}
        class="bio__portrait"
        widths={widths}
        sizes={sizes}
        style={portraitPosition ? `--pos: ${portraitPosition}` : undefined}
      />
    </div>

    <div class="bio__copy">
      <p class="reveal eyebrow bio__label" data-reveal>{t.sections.bio.eyebrow}</p>
      <div class="reveal bio__text" data-reveal style="--reveal-i: 1">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .bio__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .bio__portrait-wrap {
    position: sticky;
    top: 6rem;
  }

  .bio__portrait {
    width: 100%;
    /* Without this the image's own height attribute wins over aspect-ratio,
       and a tall source stretches the frame to its full pixel height. */
    height: auto;
    aspect-ratio: 4 / 5;
    /* Never taller than the viewport it sticks to. */
    max-height: calc(100svh - 8rem);
    object-fit: cover;
    object-position: var(--pos, center);
    filter: grayscale(0.35) contrast(1.05);
  }

  .bio__label {
    margin-bottom: var(--space-md);
  }

  .bio__text {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--fg);
    max-width: 26ch;
  }

  .bio__text :global(p + p) {
    margin-top: 1em;
  }

  @media (max-width: 56em) {
    .bio__grid {
      grid-template-columns: 1fr;
    }

    .bio__portrait-wrap {
      position: static;
      max-width: 22rem;
    }

    .bio__text {
      max-width: none;
      font-size: var(--fs-h3);
    }
  }
</style>
