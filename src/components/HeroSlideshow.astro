---
import { Image } from 'astro:assets';

interface Props {
  images: {
    image: ImageMetadata;
    position?: string;
    mobileImage?: ImageMetadata;
    mobilePosition?: string;
  }[];
  interval: number;
}

const { images, interval } = Astro.props;

// The slide fills the viewport and the Ken Burns pass scales it to 1.08, so
// the painted width runs past 100vw. Candidates go up to 3x-display territory
// and are capped per image so Astro never upscales a smaller source.
const SIZES = '108vw';
const LADDER = [640, 1024, 1600, 2048, 2560, 3200, 3840];
const widthsFor = (img: ImageMetadata) => {
  const usable = LADDER.filter((w) => w <= img.width);
  // Nothing in the ladder fits a small source — offer its native width alone.
  return usable.length ? usable : [img.width];
};
---

<div class="hero__slideshow" data-hero-slideshow data-interval={interval}>
  {
    images.map(({ image, position, mobileImage, mobilePosition }, i) => (
      <div class:list={['hero__slide', i === 0 && 'is-active']}>
        <Image
          src={image}
          alt=""
          class:list={['hero__slide-img', mobileImage && 'hero__slide-img--desktop-only']}
          widths={widthsFor(image)}
          sizes={SIZES}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
          style={position ? `--pos: ${position}` : undefined}
        />
        {mobileImage && (
          <Image
            src={mobileImage}
            alt=""
            class="hero__slide-img hero__slide-img--mobile-only"
            widths={widthsFor(mobileImage)}
            sizes={SIZES}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            style={mobilePosition ? `--pos: ${mobilePosition}` : undefined}
          />
        )}
      </div>
    ))
  }
</div>

<style>
  .hero__slideshow {
    position: absolute;
    inset: 0;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transform: scale(1);
    transition:
      opacity var(--dur-slow) var(--ease-in-out),
      transform 6s linear;
  }

  .hero__slide.is-active {
    opacity: 1;
    transform: scale(1.08);
  }

  .hero__slide-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, center);
  }

  /* Only relevant when a slide has a mobileImage override — otherwise
     there's just one (unclassed) image and this never applies. */
  .hero__slide-img--mobile-only {
    display: none;
  }

  @media (max-width: 40em) {
    .hero__slide-img--desktop-only {
      display: none;
    }
    .hero__slide-img--mobile-only {
      display: block;
    }
  }
</style>
