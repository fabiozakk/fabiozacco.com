---
import { Image } from 'astro:assets';

interface Props {
  images: { image: ImageMetadata; position?: string }[];
  interval: number;
}

const { images, interval } = Astro.props;
---

<div class="hero__slideshow" data-hero-slideshow data-interval={interval}>
  {
    images.map(({ image, position }, i) => (
      <Image
        src={image}
        alt=""
        class:list={['hero__slide', i === 0 && 'is-active']}
        widths={[640, 1024, 1600, 2400]}
        sizes="100vw"
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : 'auto'}
        style={position ? `--pos: ${position}` : undefined}
      />
    ))
  }
</div>

<style>
  .hero__slideshow {
    position: absolute;
    inset: 0;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, center);
    opacity: 0;
    transform: scale(1);
    transition:
      opacity var(--dur-slow) var(--ease-in-out),
      transform 6s linear;
  }

  .hero__slide.is-active {
    opacity: 1;
    transform: scale(1.08);
  }
</style>
