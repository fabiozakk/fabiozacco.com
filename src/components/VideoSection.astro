---
import VideoCard from './VideoCard.astro';

interface Entry {
  id: string;
  title: string;
  role?: string;
  year?: number;
  featured?: boolean;
  thumbnail?: ImageMetadata;
}

interface Props {
  id: string;
  number: string;
  title: string;
  description: string;
  entries: Entry[];
}

const { id, number, title, description, entries } = Astro.props;
---

<section id={id} class="video-section">
  <div class="container">
    <div class="video-section__head">
      <p class="reveal eyebrow" data-reveal>{number} — {title}</p>
      <h2 class="reveal display video-section__title" data-reveal style="--reveal-i: 1">{title}</h2>
      <p class="reveal video-section__desc" data-reveal style="--reveal-i: 2">{description}</p>
    </div>

    {
      entries.length > 0 ? (
        <div class="video-section__grid">
          {entries.map((entry, i) => (
            <VideoCard
              id={entry.id}
              title={entry.title}
              role={entry.role}
              year={entry.year}
              featured={entry.featured}
              thumbnail={entry.thumbnail}
              index={i}
            />
          ))}
        </div>
      ) : (
        <p class="video-section__empty">No videos yet — add one from the CMS panel.</p>
      )
    }
  </div>
</section>

<style>
  .video-section__head {
    max-width: 42rem;
    margin-bottom: var(--space-lg);
  }

  .video-section__title {
    font-size: var(--fs-h2);
    margin-top: var(--space-sm);
  }

  .video-section__desc {
    margin-top: var(--space-sm);
    color: var(--muted);
    max-width: 38ch;
  }

  .video-section__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .video-section__empty {
    color: var(--muted);
  }

  @media (max-width: 56em) {
    .video-section__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
